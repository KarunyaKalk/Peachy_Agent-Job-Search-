# ==========================================
# PEACHY - ENVIRONMENT VARIABLES CONFIGURATION
# ==========================================

# Environment & Server
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change_this_to_a_super_secret_jwt_key_in_production_32_bytes_min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200  # 30 days

# Frontend & CORS
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Database
# Local SQLite default (uncomment PostgreSQL for Docker / production):
DATABASE_URL=sqlite:///./peachy.db
# POSTGRES_USER=peachy
# POSTGRES_PASSWORD=peachy_secure_password
# POSTGRES_DB=peachy_db
# POSTGRES_HOST=db
# POSTGRES_PORT=5432
# DATABASE_URL=postgresql://peachy:peachy_secure_password@db:5432/peachy_db

# Redis / Celery (Scheduled Tasks)
REDIS_URL=redis://localhost:6379/0

# LLM Integration (Anthropic Claude API)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
LLM_MODEL=claude-3-5-sonnet-20241022

# External Job Search APIs (Module 2)
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key
RAPIDAPI_KEY=your_rapidapi_key_for_jsearch

# Contact Enrichment APIs (Module 6)
HUNTER_API_KEY=your_hunter_io_api_key
APOLLO_API_KEY=your_apollo_io_api_key

# Email Sending / Cold Outreach (Module 6)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your_sendgrid_api_key
EMAIL_FROM=you@yourdomain.com
EMAIL_FROM_NAME=Your Name
